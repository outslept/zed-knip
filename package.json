{
  "name": "zed-knip",
  "version": "0.2.0",
  "private": true,
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.21.0",
  "type": "module",
  "scripts": {
    "test": "node --test src/*.test.js test/*.test.js",
    "test:unit": "node --test src/*.test.js",
    "test:e2e": "node --test test/*.test.js",
    "build": "cargo build --release --locked --target wasm32-wasip2",
    "lint": "cargo lint",
    "fmt": "cargo fmt --all",
    "fmt:check": "cargo fmt --all -- --check",
    "check-versions": "node scripts/sync-versions.mjs --check",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-versions.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@knip/language-server": "^3.1.4"
  }
}
